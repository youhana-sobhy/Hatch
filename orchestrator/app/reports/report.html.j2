<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Onboarding report · {{ onboarding.hostname }}</title>
<style>
  :root { --ink:#0f172a; --muted:#64748b; --line:#e2e8f0; --ok:#15803d; --bad:#b91c1c; --warn:#b45309; }
  * { box-sizing: border-box; }
  body { font: 14px/1.5 -apple-system, "Segoe UI", Inter, Roboto, sans-serif; color: var(--ink); margin: 0; background: #fff; }
  main { max-width: 960px; margin: 0 auto; padding: 40px 24px; }
  header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid var(--ink); padding-bottom: 16px; }
  h1 { font-size: 24px; margin: 0; } h2 { font-size: 16px; margin: 32px 0 8px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .brand { font-weight: 700; letter-spacing: .08em; }
  .pill { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; border: 1px solid currentColor; }
  .ok { color: var(--ok); } .bad { color: var(--bad); } .warn { color: var(--warn); }
  dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px 24px; margin: 16px 0 0; }
  dt { color: var(--muted); font-size: 12px; } dd { margin: 0; font-weight: 500; word-break: break-all; }
  table { width: 100%; border-collapse: collapse; } th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: 12px; color: var(--muted); font-weight: 600; }
  code { font: 12px ui-monospace, SFMono-Regular, Menlo, monospace; }
  footer { margin-top: 40px; color: var(--muted); font-size: 12px; }
  @media print { main { padding: 0; } h2 { break-after: avoid; } tr { break-inside: avoid; } }
</style>
</head>
<body>
<main>
  <header>
    <div>
      <div class="brand">HATCH · ONBOARDING REPORT</div>
      <h1>{{ onboarding.hostname }}</h1>
      <div style="color:var(--muted)">{{ onboarding.vendor }} {{ onboarding.model }} · {{ onboarding.role }} · {{ onboarding.site }} ({{ onboarding.market }})</div>
    </div>
    {% set good = onboarding.status == 'COMPLETED' %}
    <span class="pill {{ 'ok' if good else 'bad' }}">{{ onboarding.status }}</span>
  </header>

  <dl>
    <div><dt>Onboarding</dt><dd><code>{{ onboarding.id }}</code></dd></div>
    <div><dt>Serial</dt><dd>{{ onboarding.serial }}</dd></div>
    <div><dt>Management IP</dt><dd>{{ onboarding.mgmt_ip }}</dd></div>
    <div><dt>Delivery mode</dt><dd>{{ 'Zero-touch (ZTP)' if onboarding.mode == 'ztp' else 'Push' }}</dd></div>
    <div><dt>Golden template</dt><dd>{{ onboarding.template }} <code>{{ onboarding.template_version }}</code></dd></div>
    <div><dt>Config SHA-256</dt><dd><code>{{ (onboarding.config_sha256 or '')[:16] }}</code></dd></div>
    <div><dt>Requested by</dt><dd>{{ onboarding.requested_by }}</dd></div>
    <div><dt>Approved by</dt><dd>{{ onboarding.approved_by or '—' }}</dd></div>
    <div><dt>Ticket</dt><dd>{{ onboarding.ticket_ref or '—' }}</dd></div>
    <div><dt>Requested</dt><dd>{{ onboarding.created_at[:19].replace('T', ' ') }} UTC</dd></div>
    <div><dt>Completed</dt><dd>{{ onboarding.completed_at[:19].replace('T', ' ') ~ ' UTC' if onboarding.completed_at else '—' }}</dd></div>
    <div><dt>Attempts</dt><dd>{{ onboarding.attempts }}</dd></div>
  </dl>

  <h2>Pipeline</h2>
  <table>
    <tr><th>Stage</th><th>Attempt</th><th>Result</th><th>Output</th></tr>
    {% for s in stages %}
    <tr>
      <td><code>{{ s.stage }}</code></td><td>{{ s.attempt }}</td>
      <td class="{{ 'ok' if s.status == 'succeeded' else ('bad' if s.status == 'failed' else 'warn') }}">{{ s.status }}</td>
      <td>{{ s.output }}</td>
    </tr>
    {% endfor %}
  </table>

  <h2>Post-checks</h2>
  {% if post_checks %}
  <table>
    <tr><th>Check</th><th>Result</th><th>Detail</th></tr>
    {% for c in post_checks %}
    <tr><td><code>{{ c.name }}</code></td><td class="{{ 'ok' if c.passed else 'bad' }}">{{ 'pass' if c.passed else 'fail' }}</td><td>{{ c.detail }}</td></tr>
    {% endfor %}
  </table>
  {% else %}<p>No post-checks recorded.</p>{% endif %}

  <h2>Security baseline · {{ compliance.passed }}/{{ compliance.total }} rules passed</h2>
  <table>
    <tr><th>Rule</th><th>Severity</th><th>Result</th><th>Evidence</th></tr>
    {% for r in compliance.rules %}
    <tr>
      <td><code>{{ r.rule_id }}</code><br>{{ r.title }}</td><td>{{ r.severity }}</td>
      <td class="{{ 'ok' if r.passed else 'bad' }}">{{ 'pass' if r.passed else 'fail' }}</td>
      <td><code>{{ r.evidence }}</code></td>
    </tr>
    {% endfor %}
  </table>

  <h2>Configuration backups</h2>
  {% if backups %}
  <table>
    <tr><th>Version</th><th>SHA-256</th><th>Stored</th></tr>
    {% for b in backups %}<tr><td>v{{ b.version }}</td><td><code>{{ b.sha256[:16] }}</code></td><td>{{ b.created_at[:19].replace('T', ' ') }} UTC</td></tr>{% endfor %}
  </table>
  {% else %}<p>No backup yet.</p>{% endif %}

  <h2>Audit trail</h2>
  <table>
    <tr><th>When (UTC)</th><th>Who</th><th>What</th></tr>
    {% for e in audit %}
    <tr><td>{{ e.at[:19].replace('T', ' ') }}</td><td>{{ e.actor }}</td><td>{{ e.action }}{% if e.to %}: {{ e['from'] or '∅' }} → {{ e.to }}{% endif %}</td></tr>
    {% endfor %}
  </table>

  <footer>Generated by Hatch. Secrets are never included in this report; values resolved from the secret store are masked.</footer>
</main>
</body>
</html>
