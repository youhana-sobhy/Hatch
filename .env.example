# Copy to orchestrator/.env for local overrides. Every variable is optional in development.
HATCH_ENV=dev
HATCH_DATABASE_URL=sqlite:///./hatch.db
HATCH_DRIVER=simulated
HATCH_EXECUTOR=thread
HATCH_WORKERS=4
HATCH_PUBLIC_ZTP_URL=http://localhost:8081

# Required in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HATCH_SECRET_KEY=

# JSON list of {token, user, role, sites}; development tokens are used when empty.
HATCH_API_TOKENS=

# Optional outbound webhooks
HATCH_NOTIFY_WEBHOOK_URL=
HATCH_MONITORING_WEBHOOK_URL=
HATCH_ITSM_WEBHOOK_URL=
